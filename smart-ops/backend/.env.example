DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/joint_collab_portal
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# Project activity emails go to active users listed as project participants.
RESEND_API_KEY=
RESEND_ENABLED=true
EMAIL_FROM=Smart Ops <notifications@pabarigroup.com>
SMART_OPS_URL=https://smart-ops-frontend-production.up.railway.app

# Auth cookie transport. Frontend/backend are on different domains in
# production, so the cookie must be Secure + SameSite=None there for the
# browser to send it cross-site. Locally over plain http, use these:
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
