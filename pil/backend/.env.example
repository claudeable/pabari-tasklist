# Local development only — never used in prod (prod uses /run/secrets, see
# Deployment & Hardening Guide). Copy to backend/.env and adjust as needed.

ENVIRONMENT=development
DEBUG=true
EXPOSE_OPENAPI_DOCS=true

DATABASE_URL=postgresql+asyncpg://scv_dev:scv_dev_password_change_me@localhost:5432/scv
REDIS_URL=redis://:scv_dev_redis_password@localhost:6379/0

ALLOWED_ORIGINS=["http://localhost:3000"]

JWT_PRIVATE_KEY_PATH=../secrets/dev/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=../secrets/dev/jwt_public_key.pem
ROOT_SECRET_PATH=../secrets/dev/root_secret.key

# Pabari ERP SSO — set in Railway env vars in production
# PABARI_URL=https://pabari-erp.up.railway.app
